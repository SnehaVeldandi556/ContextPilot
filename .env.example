# ContextPilot Environment Configuration

# Supabase Postgres Connection (relational tables + pgvector)
# Supabase pooler URL (port 6543) - used by FastAPI backend and Streamlit dashboard
DATABASE_URL=postgresql+psycopg2://postgres.your-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase direct URL (port 5432) - used only by Alembic migrations
DIRECT_URL=postgresql+psycopg2://postgres:your-db-password@db.your-ref.supabase.co:5432/postgres

# Test database URL (optional: if omitted, unit/mock tests run on an isolated test DB or SQLite)
TEST_DATABASE_URL=

# LLM Providers (LangChain)
# If OPENAI_API_KEY is not set or set to "mock", ContextPilot runs with the built-in deterministic Mock LLM provider
OPENAI_API_KEY=mock
OPENAI_MODEL=gpt-4o-mini

# Second LLM provider option (anthropic, groq, or mock)
SECOND_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Pipeline Configuration & Thresholds
CONTEXTPILOT_DEFAULT_MODE=guarded
CONTEXTPILOT_TOKEN_BUDGET=2000
CONTEXTPILOT_SKIP_THRESHOLD_TOKENS=2000
CONTEXTPILOT_DEDUPE_THRESHOLD=0.92
CONTEXTPILOT_SCORE_DROP_RATIO=0.35
CONTEXTPILOT_GUARD_THRESHOLD=0.50
CONTEXTPILOT_AGGRESSIVE_GUARD_THRESHOLD=0.30
CONTEXTPILOT_SENTENCE_PRUNE_THRESHOLD=0.20
CONTEXTPILOT_SHADOW_SAMPLE_RATE=1.0
CONTEXTPILOT_SHADOW_MATCH_THRESHOLD=0.80

# Embedding & Cross-Encoder Models (Hugging Face)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
DEVICE=cpu

# App Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
